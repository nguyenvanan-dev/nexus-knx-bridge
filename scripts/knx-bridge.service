[Unit]
Description=KNX AI Bridge (OpenClaw)
After=network.target

[Service]
Type=simple
User=an
WorkingDirectory=/home/an/knx-bridge
ExecStart=/home/an/knx-bridge/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 5055
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

# Log limits to prevent SD card fill-up
StandardOutput=append:/var/log/knx-bridge.log
StandardError=append:/var/log/knx-bridge.log

[Install]
WantedBy=multi-user.target
