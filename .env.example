KNX_API_TOKEN=GENERATE_WITH_OPENSSL_RAND_HEX_32
API_KEY=GENERATE_WITH_OPENSSL_RAND_HEX_32
SETUP_BOOTSTRAP_TOKEN=GENERATE_WITH_OPENSSL_RAND_HEX_24

BACKEND_URL=http://127.0.0.1:5055
KNX_GATEWAY_IP=127.0.0.1
KNX_GATEWAY_PORT=3671
